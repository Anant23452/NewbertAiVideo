{
  "name": "newbert-ai-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:f3": "tsx watch --env-file-if-exists=apps/api/.env apps/api/src/main.ts",
    "check:f3": "tsc -p tsconfig.backend.json --noEmit",
    "test:f3": "tsx --test --test-concurrency=1 tests/f3/*.test.ts",
    "auth:setup": "node scripts/db/setup-auth.mjs",
    "dev:f2": "tsx watch --env-file-if-exists=apps/api/.env apps/api/src/main.ts",
    "build:api": "tsc -p tsconfig.backend.json",
    "start:api": "node --env-file-if-exists=apps/api/.env dist/apps/api/src/main.js",
    "check:f2": "tsc -p tsconfig.backend.json --noEmit",
    "test:f2": "tsx --test --test-concurrency=1 tests/f2/*.test.ts",
    "db:local": "node scripts/db/local.mjs",
    "db:migrate": "node --env-file-if-exists=apps/api/.env scripts/db/cli.mjs up",
    "db:status": "node --env-file-if-exists=apps/api/.env scripts/db/cli.mjs status",
    "dev:f1": "node --env-file-if-exists=apps/api/.env apps/api/src/main.mjs",
    "check:f1": "node --check apps/api/src/config.mjs && node --check apps/api/src/app.mjs && node --check apps/api/src/main.mjs",
    "prototype": "node --env-file=.env scripts/prototype.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check lib/jobs.mjs",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3001",
    "build:web": "next build apps/web",
    "start:web": "next start apps/web --hostname 127.0.0.1 --port 3001",
    "check:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "dev:api": "tsx watch --env-file-if-exists=apps/api/.env apps/api/src/main.ts",
    "test:f4": "tsx --test tests/f4/*.test.ts",
    "test:f4:browser": "node tests/f4/browser.mjs",
    "auth:mail": "node --env-file-if-exists=apps/api/.env scripts/auth/local-mail.mjs",
    "format:web": "prettier --write \"apps/web/**/*.{ts,tsx,css,mjs,json}\" \"tests/f4/*.{ts,mjs}\"",
    "worker:setup": "node scripts/db/setup-worker.mjs",
    "dev:worker": "tsx --env-file-if-exists=apps/api/.env apps/worker/src/main.ts",
    "check:f5": "tsc -p tsconfig.backend.json --noEmit",
    "test:f5": "tsx --test --test-concurrency=1 tests/f5/*.test.ts",
    "test:f6": "tsx --test --test-concurrency=1 tests/f6/*.test.ts",
    "test:f5:browser": "node tests/f5/browser.mjs",
    "processing": "node scripts/db/processing.mjs",
    "media:audit": "node scripts/db/media-audit.mjs",
    "start:worker": "node --env-file-if-exists=apps/api/.env dist/apps/worker/src/main.js",
    "test:f7": "tsx --test --test-concurrency=1 tests/f7/*.test.ts",
    "test:f8": "npm run test:f7",
    "test:f7:browser": "tsx tests/f7/browser.ts",
    "test:f8:browser": "npm run test:f7:browser"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "fastify": "5.12.7",
    "ffmpeg-static": "^5.3.0",
    "kysely": "0.29.7",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "node-pg-migrate": "9.0.0",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
