# F1 uses its own optional apps/api/.env file. Root prototype keys are not loaded.
F1_HOST=127.0.0.1
F1_PORT=3100

# F2 Fastify API. Copy this file to apps/api/.env, or run db:local first.
API_HOST=127.0.0.1
API_PORT=3100
# Restricted role URL only; never use migration/owner credentials for the API.
RUNTIME_DATABASE_URL=
