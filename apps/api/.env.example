# F1 uses its own optional apps/api/.env file. Root prototype keys are not loaded.
F1_HOST=127.0.0.1
F1_PORT=3100

# F2 Fastify API. Copy this file to apps/api/.env, or run db:local first.
API_HOST=127.0.0.1
API_PORT=3100
# Restricted role URL only; never use migration/owner credentials for the API.
RUNTIME_DATABASE_URL=

# F3 identity service: a separate restricted login, not the migration owner.
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
AUTH_BASE_URL=http://127.0.0.1:3001
APP_ORIGIN=http://127.0.0.1:3001
# Local delivery writes to ignored .local/auth-mailbox. Production requires SMTP.
AUTH_MAIL_MODE=local
SMTP_URL=
AUTH_MAIL_FROM=

# F6 separate restricted worker login. Provision locally with worker:setup.
WORKER_DATABASE_URL=

# F7/F8: optional overrides. Named Gemini/voice values otherwise use ignored root .env.
# Account quotas/billing apply; no model fallback or paid search grounding.
PLANNING_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=

# F9/F10 operator-managed speech; named values may also live in ignored root .env.
SPEECH_ENABLED=true
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
FFMPEG_PATH=
# Non-Windows only, after installing compatible Devanagari fonts:
DEVANAGARI_FONT_READY=false

# F13 Instagram Login. Keep secrets server-side; do not paste into chat.
# Choose the version supported/tested in your Meta app before enabling.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=
# Must exactly match APP_ORIGIN + /api/v1/instagram/callback and Meta's registered URI.
INSTAGRAM_REDIRECT_URI=
# 64 hexadecimal characters. Production requires an external key/secret manager.
# Local loopback development may use instagram:setup's ignored key file.
INSTAGRAM_TOKEN_KEY=
