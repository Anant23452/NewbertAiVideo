# F1 uses its own optional apps/api/.env file. Root prototype keys are not loaded.
F1_HOST=127.0.0.1
F1_PORT=3100

# F2 Fastify API. Copy this file to apps/api/.env, or run db:local first.
API_HOST=127.0.0.1
API_PORT=3100
# Restricted role URL only; never use migration/owner credentials for the API.
RUNTIME_DATABASE_URL=

# F3 identity service: a separate restricted login, not the migration owner.
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
AUTH_BASE_URL=http://127.0.0.1:3100
APP_ORIGIN=http://127.0.0.1:3100
# Local delivery writes to ignored .local/auth-mailbox. Production requires SMTP.
AUTH_MAIL_MODE=local
SMTP_URL=
AUTH_MAIL_FROM=
