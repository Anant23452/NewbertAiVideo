HOST=127.0.0.1
PORT=3000
# Keep these on the server. Never paste keys into project notes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
# Optional absolute path to an installed FFmpeg executable with the ass filter.
FFMPEG_PATH=
DAILY_GENERATIONS=3
MAX_AUDIO_SECONDS=180
# Set only behind HTTPS in a deployed environment.
SECURE_COOKIES=false
